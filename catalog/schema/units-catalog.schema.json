{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://units-x.dev/schema/units-catalog.schema.json",
  "title": "units-x catalog schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "conversion_policies",
    "dimensions",
    "bridges"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/non_blank_string"
    },
    "catalog_version": {
      "$ref": "#/$defs/non_blank_string"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "bridges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bridge"
      }
    },
    "conversion_policies": {
      "$ref": "#/$defs/conversion_policies"
    }
  },
  "$defs": {
    "non_blank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^.*\\S.*$"
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left_public_type",
        "right_public_type"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "reciprocal"
          ]
        },
        "left_public_type": {
          "$ref": "#/$defs/non_blank_string"
        },
        "right_public_type": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "nullable_non_blank_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/non_blank_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_expected_failure_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "api_surface": {
      "type": "string",
      "enum": [
        "identity",
        "to_unit",
        "try_to_unit",
        "try_to_quantity",
        "to_reciprocal_quantity"
      ]
    },
    "infallibility_guard": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "same_storage_float_range",
        null
      ]
    },
    "storage_name": {
      "type": "string",
      "enum": [
        "i32",
        "f32",
        "f64"
      ]
    },
    "conversion_policy_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "api_surface",
        "expected_failure",
        "infallibility_guard",
        "fallback_policy_id"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "api_surface": {
          "$ref": "#/$defs/api_surface"
        },
        "expected_failure": {
          "$ref": "#/$defs/nullable_expected_failure_string"
        },
        "infallibility_guard": {
          "$ref": "#/$defs/infallibility_guard"
        },
        "fallback_policy_id": {
          "$ref": "#/$defs/nullable_non_blank_string"
        }
      }
    },
    "storage_pair_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_storage",
        "target_storage",
        "policy_id"
      ],
      "properties": {
        "source_storage": {
          "$ref": "#/$defs/storage_name"
        },
        "target_storage": {
          "$ref": "#/$defs/storage_name"
        },
        "policy_id": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "same_public_type_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_policy_id",
        "storage_pair_policies"
      ],
      "properties": {
        "identity_policy_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "storage_pair_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storage_pair_policy"
          }
        }
      }
    },
    "cross_public_type_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_surface",
        "storage_pair_policies"
      ],
      "properties": {
        "api_surface": {
          "$ref": "#/$defs/api_surface"
        },
        "storage_pair_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storage_pair_policy"
          }
        },
        "base_failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        }
      }
    },
    "conversion_policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_public_type",
        "same_canonical_dimension",
        "reciprocal_bridge",
        "policies"
      ],
      "properties": {
        "same_public_type": {
          "$ref": "#/$defs/same_public_type_policy"
        },
        "same_canonical_dimension": {
          "$ref": "#/$defs/cross_public_type_policy"
        },
        "reciprocal_bridge": {
          "$ref": "#/$defs/cross_public_type_policy"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/conversion_policy_entry"
          }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scale_to_base",
        "offset_to_base"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "linear",
            "affine"
          ]
        },
        "scale_to_base": {
          "type": "number"
        },
        "offset_to_base": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "linear"
              }
            }
          },
          "then": {
            "properties": {
              "offset_to_base": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "affine"
              }
            }
          },
          "then": {
            "properties": {
              "offset_to_base": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_code_id",
        "unit_symbol",
        "display_name",
        "binary_unit_id",
        "reserved_word_alias",
        "aliases",
        "conversion"
      ],
      "properties": {
        "unit_code_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "unit_symbol": {
          "$ref": "#/$defs/non_blank_string"
        },
        "display_name": {
          "$ref": "#/$defs/non_blank_string"
        },
        "binary_unit_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "reserved_word_alias": {
          "$ref": "#/$defs/nullable_non_blank_string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      }
    },
    "json_scalar_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_ids",
        "encoding"
      ],
      "properties": {
        "type_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_blank_string"
          }
        },
        "encoding": {
          "type": "string",
          "enum": [
            "object"
          ]
        }
      }
    },
    "json_small_array_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id_template",
        "encoding"
      ],
      "properties": {
        "type_id_template": {
          "$ref": "#/$defs/non_blank_string"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "array"
          ]
        }
      }
    },
    "json_buffer_form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id_template",
        "encoding"
      ],
      "properties": {
        "type_id_template": {
          "$ref": "#/$defs/non_blank_string"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "base64-le"
          ]
        }
      }
    },
    "json_forms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scalar",
        "small_array",
        "buffer"
      ],
      "properties": {
        "scalar": {
          "$ref": "#/$defs/json_scalar_form"
        },
        "small_array": {
          "$ref": "#/$defs/json_small_array_form"
        },
        "buffer": {
          "$ref": "#/$defs/json_buffer_form"
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi_name_stem",
        "binary_schema_id"
      ],
      "properties": {
        "abi_name_stem": {
          "$ref": "#/$defs/non_blank_string"
        },
        "binary_schema_id": {
          "$ref": "#/$defs/non_blank_string"
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "canonical_dimension_id",
        "family",
        "public_type",
        "base_unit_code_id",
        "json_forms",
        "abi",
        "units"
      ],
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "canonical_dimension_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "family": {
          "type": "string",
          "enum": [
            "base",
            "geometry",
            "mechanical",
            "electromagnetic"
          ]
        },
        "public_type": {
          "$ref": "#/$defs/non_blank_string"
        },
        "base_unit_code_id": {
          "$ref": "#/$defs/non_blank_string"
        },
        "json_forms": {
          "$ref": "#/$defs/json_forms"
        },
        "abi": {
          "$ref": "#/$defs/abi"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      }
    }
  }
}
